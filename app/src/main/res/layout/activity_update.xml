<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- HEADER -->
    <ImageView
        android:id="@+id/ivHeaderLeft"
        android:layout_width="110dp"
        android:layout_height="90dp"
        app:srcCompat="@drawable/icontrang"
        android:contentDescription="logo left"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:id="@+id/ivHeaderRight"
        android:layout_width="189dp"
        android:layout_height="96dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="logo right"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/ivHeaderLeft"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/iconchu" />
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginTop="16dp"
        android:background="@color/greenStroke"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivHeaderLeft" />

    <!-- Tên món ăn -->
    <EditText
        android:id="@+id/foodnameupdate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="料理名を入力"
        android:inputType="text"
        android:background="@drawable/bg_edittext"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/grayText"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Loại món -->
    <EditText
        android:id="@+id/foodcategoryupdate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="カテゴリーを入力"
        android:inputType="text"
        android:background="@drawable/bg_edittext"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/grayText"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/foodnameupdate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Nút Update -->
    <Button
        android:id="@+id/update_button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="更新"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/greenPrimary"
        android:textColor="@android:color/white"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/foodcategoryupdate"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Nút Delete -->
    <Button
        android:id="@+id/delete_button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="削除"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@android:color/holo_red_dark"
        android:textColor="@android:color/white"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toTopOf="@id/update_button"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
