<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- HEADER -->
    <ImageView
        android:id="@+id/ivHeaderLeft"
        android:layout_width="110dp"
        android:layout_height="90dp"
        app:srcCompat="@drawable/icontrang"
        android:contentDescription="logo left"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:id="@+id/ivHeaderRight"
        android:layout_width="189dp"
        android:layout_height="96dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="logo right"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/ivHeaderLeft"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/iconchu" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginTop="16dp"
        android:background="@color/greenStroke"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivHeaderLeft" />

    <!-- SEARCH -->
    <LinearLayout
        android:id="@+id/searchBox"
        android:layout_width="340dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_search"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="search"
            app:srcCompat="@drawable/iconsearch"
            app:tint="@color/greenStroke"
            tools:ignore="UseAppTint" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="検索…"
            android:imeOptions="actionSearch"
            android:paddingStart="12dp"
            android:textColor="@color/textPrimary" />
    </LinearLayout>

    <!-- SECTION -->
    <TextView
        android:id="@+id/tvSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="私のレシピ"
        android:textStyle="bold"
        android:textColor="@color/greenPrimary"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/searchBox"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="8dp"/>

    <!-- LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecipes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvSection"
        app:layout_constraintBottom_toTopOf="@id/add_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"/>

    <!-- ADD RECIPE CARD -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/add_button"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        app:strokeColor="@color/greenStroke"
        app:strokeWidth="3dp"
        app:cardCornerRadius="16dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintTop_toBottomOf="@id/rvRecipes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/fabChat">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:srcCompat="@drawable/iconplus"
                android:contentDescription="add"
                app:tint="@color/greenPrimary" />

            <TextView
                android:id="@+id/tvAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" レシピを追加"
                android:textColor="@color/greenPrimary"
                android:textStyle="bold"
                android:textSize="16sp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- FAB CHAT -->
    <ImageButton
        android:id="@+id/fabChat"
        android:layout_width="80dp"
        android:layout_height="70dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_fab"
        android:contentDescription="Chat with AI"
        android:scaleType="centerInside"
        android:padding="0dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:srcCompat="@drawable/iconai"
    app:tint="@null" />
</androidx.constraintlayout.widget.ConstraintLayout>
