<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- HEADER -->
    <ImageView
        android:id="@+id/ivHeaderLeft"
        android:layout_width="110dp"
        android:layout_height="90dp"
        app:srcCompat="@drawable/icontrang"
        android:contentDescription="logo left"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:id="@+id/ivHeaderRight"
        android:layout_width="189dp"
        android:layout_height="96dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="logo right"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivHeaderLeft"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/iconchu" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginTop="16dp"
        android:background="@color/greenStroke"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivHeaderLeft" />

    <!-- Dùng ScrollView để full màn khi bàn phím mở -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <!-- Tên món ăn -->
    <EditText
        android:id="@+id/foodname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="料理名を入力"
        android:inputType="text"
        android:background="@drawable/bg_edittext"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/grayText"
        android:padding="12dp"
        android:layout_marginTop="24dp" />

    <!-- Loại món -->
    <EditText
        android:id="@+id/foodcategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="カテゴリーを入力"
        android:inputType="text"
        android:background="@drawable/bg_edittext"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/grayText"
        android:padding="12dp"
        android:layout_marginTop="16dp" />

    <!-- Nút Add -->
    <Button
        android:id="@+id/add_button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="追加"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/greenPrimary"
        android:textColor="@android:color/white"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/foodcategory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />
    </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>